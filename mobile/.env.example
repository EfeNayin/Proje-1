# Copy to .env and set your machine's LAN address.
#
# Must NOT be localhost: on a phone, localhost is the phone itself. Find yours
# with (PowerShell):
#   Get-NetIPAddress -AddressFamily IPv4 | Where-Object { $_.InterfaceAlias -like "Wi-Fi*" }
#
# The phone and the computer have to be on the same network. Verify by opening
# http://<that-ip>:8000/health in the phone's browser first.
EXPO_PUBLIC_API_URL=http://192.168.1.34:8000
