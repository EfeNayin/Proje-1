# ── BodyTrack backend ortam değişkenleri (ÖRNEK) ──
# Bu dosyayı kopyala:  cp .env.example .env   ve değerleri doldur.
# .env ASLA git'e commit'lenmez (.gitignore'da hariç tutuldu).

# ── Veritabanı ──
# Async SQLAlchemy + asyncpg için şema "postgresql+asyncpg" olmalı.
# Host "db" → docker-compose servis adı (compose ağı içinde DNS olur).
# Docker'sız lokal çalışırken "db" yerine "localhost" yaz.
DATABASE_URL=postgresql+asyncpg://bodytrack:bodytrack@db:5432/bodytrack
POSTGRES_USER=bodytrack
POSTGRES_PASSWORD=bodytrack
POSTGRES_DB=bodytrack

# Barındırılan veritabanı (staging; örnekler yer tutucudur, GERÇEK DEĞERİ buraya yazma):
#   DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME?ssl=verify-full
# Neon'un panelde verdiği libpq dizesindeki `sslmode=require` ve `channel_binding=require`
# asyncpg'de GEÇMEZ (backend bunları açıkça reddeder): silip yerine ?ssl=verify-full yaz.
# DOĞRUDAN (pooler OLMAYAN) host'u kullan. staging/production ?ssl=verify-full olmadan açılmaz.
# Bağlantı havuzu (varsayılanlar SQLAlchemy'ninkidir; küçük barındırılan veritabanı için kısılır):
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE_SECONDS=-1

# ── Redis ──
REDIS_URL=redis://redis:6379/0
# Barındırılan Redis (Upstash; TLS her zaman açık): rediss://default:TOKEN@HOST:6379
# staging/production rediss:// olmadan açılmaz; sertifika VE ana makine adı her zaman doğrulanır.

# ── JWT / Güvenlik ──
# BU DEĞER REPODA HERKESE AÇIK. Yerel geliştirmede de, .env'i oluşturur oluşturmaz
# kendi rastgele değerinle DEĞİŞTİR (en az 32 bayt; staging/production bunun altında
# hiç açılmaz):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Anahtarı değiştirmek mevcut tüm token'ları geçersiz kılar (herkes yeniden giriş yapar).
JWT_SECRET_KEY=degistir-bu-degeri-uretimde
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ── Hız sınırları (Redis'te paylaşılır; gerekçeler README.md'de, "Hız sınırları") ──
# Hepsi isteğe bağlı: satırı açmazsan gösterilen varsayılan geçerlidir. Süreler saniyedir.
# RATE_LIMIT_KEY_PREFIX=bt:rl
# RATE_LIMIT_REDIS_TIMEOUT_SECONDS=0.5
# RATE_LIMIT_LOGIN_IP_LIMIT=40
# RATE_LIMIT_LOGIN_IP_WINDOW_SECONDS=600
# RATE_LIMIT_LOGIN_ACCOUNT_IP_LIMIT=5
# RATE_LIMIT_LOGIN_ACCOUNT_IP_WINDOW_SECONDS=900
# RATE_LIMIT_LOGIN_ACCOUNT_LIMIT=50
# RATE_LIMIT_LOGIN_ACCOUNT_WINDOW_SECONDS=3600
# RATE_LIMIT_REGISTER_IP_LIMIT=20
# RATE_LIMIT_REGISTER_IP_WINDOW_SECONDS=3600
# RATE_LIMIT_REFRESH_IP_LIMIT=60
# RATE_LIMIT_REFRESH_IP_WINDOW_SECONDS=600
# RATE_LIMIT_REFRESH_USER_LIMIT=30
# RATE_LIMIT_REFRESH_USER_WINDOW_SECONDS=600
# RATE_LIMIT_INVITE_USER_LIMIT=10
# RATE_LIMIT_INVITE_USER_WINDOW_SECONDS=600
# RATE_LIMIT_INVITE_IP_LIMIT=30
# RATE_LIMIT_INVITE_IP_WINDOW_SECONDS=600

# RATE_LIMIT_RECOVERY_REQUEST_IP_LIMIT=15
# RATE_LIMIT_RECOVERY_REQUEST_IP_WINDOW_SECONDS=3600
# RATE_LIMIT_RECOVERY_REQUEST_ACCOUNT_LIMIT=5
# RATE_LIMIT_RECOVERY_REQUEST_ACCOUNT_WINDOW_SECONDS=3600
# RATE_LIMIT_RECOVERY_RESEND_COOLDOWN_SECONDS=60
# RATE_LIMIT_RECOVERY_CONFIRM_IP_LIMIT=30
# RATE_LIMIT_RECOVERY_CONFIRM_IP_WINDOW_SECONDS=900
# RATE_LIMIT_RECOVERY_CONFIRM_ACCOUNT_LIMIT=10
# RATE_LIMIT_RECOVERY_CONFIRM_ACCOUNT_WINDOW_SECONDS=900

# ── Parola işi (bcrypt) ──
# Hash/doğrulama bu sayıda işçi iş parçacığında çalışır (olay döngüsünde değil); en fazla
# MAX_QUEUED iş daha bekler, ötesi 503 alır. Küçük barındırılan örnek için kısılır.
# PASSWORD_WORK_WORKERS=4
# PASSWORD_WORK_MAX_QUEUED=64

# ── Parola kurtarma ──
# Kod ömrü (saniye, 60-3600) ve bir koda tanınan yanlış deneme sayısı (1-10).
# PASSWORD_RESET_CODE_TTL_SECONDS=900
# PASSWORD_RESET_MAX_ATTEMPTS=5

# ── Giden e-posta (SMTP) — GERÇEK DEĞERLERİ BURAYA YAZMA, yalnızca kendi backend/.env'ine ──
# SMTP_HOST boşsa teslimat yapılmaz: kurtarma isteği yine aynı yanıtı alır ama kod
# üretilmez/gönderilmez. staging/production SMTP_HOST'suz ve SMTP_SECURITY=none ile
# AÇILMAZ. Sağlayıcı/alan adı henüz seçilmedi: aşağıdakiler yer tutucudur.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# starttls (587) | implicit (465) | none (yalnızca development, yerel test kutusu için)
# SMTP_SECURITY=starttls
# SMTP_USERNAME=your-username
# SMTP_PASSWORD=change-me
# SMTP_FROM=BodyTrack <no-reply@example.invalid>
# SMTP_TIMEOUT_SECONDS=10
# SMTP_MAX_CONCURRENT=4
# SMTP_MAX_PENDING=100

# Gönderim tek bir taşıyıcıyla yapılır; biri diğerine otomatik geçmez:
# smtp (varsayılan) | resend (HTTPS; SMTP portlarını kapatan barındırıcılar için)
# MAIL_TRANSPORT=smtp
# Gönderen adres (boşsa SMTP_FROM). Resend için Resend'de DOĞRULANMIŞ bir alan adında olmalı.
# MAIL_FROM=BodyTrack <no-reply@your-verified-domain.example>

# ── Giden e-posta (Resend, HTTPS) — GERÇEK ANAHTARI BURAYA YAZMA ──
# staging/production MAIL_TRANSPORT=resend iken RESEND_API_KEY, https RESEND_API_URL ve gerçek
# bir MAIL_FROM olmadan AÇILMAZ.
# RESEND_API_KEY=re_change_me
# RESEND_API_URL=https://api.resend.com/emails
# RESEND_TIMEOUT_SECONDS=10
# RESEND_MAX_CONCURRENT=4
# RESEND_MAX_PENDING=100

# ── Uygulama ──
ENVIRONMENT=development

# ── Üretim imajı (backend/deploy/start.sh; yerel geliştirmede kullanılmaz) ──
# PORT=8000                 # Render atar (varsayılan 10000)
# RUN_MIGRATIONS=true       # true: açılışta `alembic upgrade head`; false: şema elle yönetilir
# FORWARDED_ALLOW_IPS=      # X-Forwarded-For'a güvenilecek proxy adresleri; "*" staging/production'da reddedilir

# ── PubMed / NCBI E-utilities (opsiyonel) ──
# Anahtar yalnızca backend'de tutulur. Boş bırakılırsa anonim limit (3 istek/sn) geçerli.
NCBI_API_KEY=
NCBI_EMAIL=
