# ── BodyTrack backend ortam değişkenleri (ÖRNEK) ──
# Bu dosyayı kopyala:  cp .env.example .env   ve değerleri doldur.
# .env ASLA git'e commit'lenmez (.gitignore'da hariç tutuldu).

# ── Veritabanı ──
# Async SQLAlchemy + asyncpg için şema "postgresql+asyncpg" olmalı.
# Host "db" → docker-compose servis adı (compose ağı içinde DNS olur).
# Docker'sız lokal çalışırken "db" yerine "localhost" yaz.
DATABASE_URL=postgresql+asyncpg://bodytrack:bodytrack@db:5432/bodytrack
POSTGRES_USER=bodytrack
POSTGRES_PASSWORD=bodytrack
POSTGRES_DB=bodytrack

# ── Redis ──
REDIS_URL=redis://redis:6379/0

# ── JWT / Güvenlik ──
# ÜRETİMDE bunu güçlü, rastgele bir değerle DEĞİŞTİR:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=degistir-bu-degeri-uretimde
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ── Uygulama ──
ENVIRONMENT=development
